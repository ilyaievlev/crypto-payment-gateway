# Local development only. Do not use these credentials in production.
POSTGRES_USER=crypto
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=payment_core
POSTGRES_PORT=15432
KAFKA_PORT=19092
# Строка PostgreSQL для локальных запусков сервисов.
DATABASE_URL=postgres://crypto:local-development-only@localhost:15432/payment_core?sslmode=disable
CHAIN_DATABASE_URL=postgres://crypto:local-development-only@localhost:15432/payment_core?sslmode=disable
VAULT_DATABASE_URL=postgres://crypto:local-development-only@localhost:15432/payment_core?sslmode=disable
KAFKA_BROKERS=localhost:19092
TRON_NILE_ENDPOINT=https://nile.trongrid.io
# Не нужен для публичной тестовой сети. Не коммитьте личный API-ключ.
TRON_NILE_API_KEY=
# Пустое значение начинает наблюдение с текущей финализированной высоты.
TRON_START_BLOCK=
LOG_LEVEL=debug
